{
  "name": "ra2-ini-assistant",
  "displayName": "RA2 INI Assistant",
  "description": "红警2 INI 文件编辑辅助插件 - 为红警2地图作者和MOD制作者提供帮助的INI配置文件编辑支持",
  "icon": "assets/icon.png",
  "version": "1.2.3",
  "publisher": "LuFeiCmm",
  "author": {
    "name": "橙猫猫三天睡不着",
    "url": "https://github.com/LufeiQD"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LufeiQD/RA2-INI-Assistant.git"
  },
  "bugs": {
    "url": "https://github.com/LufeiQD/RA2-INI-Assistant/issues"
  },
  "homepage": "https://github.com/LufeiQD/RA2-INI-Assistant#readme",
  "keywords": [
    "ra2",
    "ini",
    "config",
    "红警",
    "命令与征服",
    "地图编辑",
    "mod",
    "编辑器",
    "插件"
  ],
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "iniExplorer",
          "title": "RA2-INI 统计助手",
          "icon": "assets/icon-ini-statistics.svg"
        }
      ]
    },
    "views": {
      "iniExplorer": [
        {
          "id": "iniStatistics",
          "name": "📊 统计信息",
          "icon": "assets/icon-ini-statistics.svg"
        },
        {
          "id": "iniUnregisteredSections",
          "name": "未注册节",
          "icon": "assets/icon-ini-statistics.svg"
        }
      ]
    },
    "languages": [
      {
        "id": "ini",
        "aliases": [
          "INI",
          "ini"
        ],
        "extensions": [
          ".ini",
          ".cfg",
          ".conf",
          ".properties"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ini",
        "scopeName": "source.ini",
        "path": "./syntaxes/ini.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "ini",
        "path": "./snippets/ini.json"
      }
    ],
    "commands": [
      {
        "command": "ini-ra2.checkDuplicates",
        "title": "INI: 检查重复配置"
      },
      {
        "command": "ini.reloadTranslations",
        "title": "Reload INI Translations",
        "category": "INI"
      },
      {
        "command": "ini.formatDocument",
        "title": "Format INI Document"
      },
      {
        "command": "ini-ra2.rebuildIndex",
        "title": "INI: 重建文件索引",
        "category": "INI"
      },
      {
        "command": "ini-ra2.insertIniReference",
        "title": "INI: 插入配置参考 (ARES & Phobos)",
        "category": "INI"
      },
      {
        "command": "ini-ra2.showStatistics",
        "title": "INI: 显示统计信息",
        "category": "INI"
      },
      {
        "command": "ini-ra2.refreshStatistics",
        "title": "INI: 刷新统计信息",
        "category": "INI"
      },
      {
        "command": "ini-ra2.batchRename",
        "title": "INI: 批量重命名（预览）",
        "category": "INI"
      },
      {
        "command": "ini-ra2.batchRenameKeys",
        "title": "INI: 批量重命名键（旧版）",
        "category": "INI"
      },
      {
        "command": "ini-ra2.copySection",
        "title": "INI: 从其他文件复制节",
        "category": "INI"
      },
      {
        "command": "ini-ra2.showIndexStats",
        "title": "INI: 查看索引与缓存状态",
        "category": "INI"
      },
      {
        "command": "ini-ra2.quickRegisterSection",
        "title": "INI: 快速注册节",
        "category": "INI"
      },
      {
        "command": "ini-ra2.quickRegisterSectionByName",
        "title": "INI: 快速注册节（按名称）",
        "category": "INI"
      },
      {
        "command": "ini-ra2.registerAllUnregisteredSections",
        "title": "INI: 一键批量注册未注册节",
        "category": "INI"
      }
    ],
    "keybindings": [
      {
        "command": "ini-ra2.insertIniReference",
        "key": "ctrl+shift+a",
        "when": "editorTextFocus && editorLangId == ini"
      },
      {
        "command": "ini-ra2.copySection",
        "key": "ctrl+alt+c",
        "when": "editorTextFocus && editorLangId == ini"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ini-ra2.copySection",
          "when": "editorTextFocus && editorLangId == ini",
          "group": "navigation@50"
        }
      ]
    },
    "configuration": {
      "title": "RA2 INI Assistant",
      "properties": {
        "ini-ra2.enableLinkUnderline": {
          "type": "boolean",
          "default": true,
          "description": "节名有引用时是否显示下划线样式（重启后生效）"
        },
        "ini-ra2.maxEmptyLinesBetweenSections": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 50,
          "description": "格式化时节与节之间的最大空行数（0-50）"
        },
        "ini-ra2.enableMultiFileSearch": {
          "type": "boolean",
          "default": true,
          "description": "启用跨文件查找节名引用（默认启用）"
        },
        "ini-ra2.relatedFiles": {
          "type": "array",
          "default": [
            "rulesmd.ini",
            "artmd.ini",
            "soundmd.ini",
            "aimd.ini",
            "rules.ini",
            "art.ini",
            "sound.ini",
            "ai.ini"
          ],
          "items": {
            "type": "string"
          },
          "description": "关联文件白名单（只在这些文件之间查找引用，可使用通配符 * ）"
        },
        "ini-ra2.maxFileSize": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 50,
          "description": "多文件搜索时单个文件的最大大小（MB）"
        },
        "ini-ra2.enableScopeDecorations": {
          "type": "boolean",
          "default": true,
          "description": "启用彩色作用域装饰（为每个节块显示淡色背景，帮助识别代码结构）"
        },
        "ini-ra2.enableAutoRename": {
          "type": "boolean",
          "default": true,
          "description": "启用自动重命名检测（编辑节名/键名后自动提示更新引用）"
        },
        "ini-ra2.autoRenameDebounce": {
          "type": "number",
          "default": 1000,
          "minimum": 100,
          "maximum": 5000,
          "description": "自动重命名检测的时间（毫秒），停止输入后等待多久触发检测"
        },
        "ini-ra2.autoRenameTrigger": {
          "type": "string",
          "enum": [
            "idle",
            "save"
          ],
          "default": "save",
          "description": "自动重命名触发方式：idle（停止输入后）或 save（保存文件后）"
        },
        "ini-ra2.enableJumpToDefinition": {
          "type": "boolean",
          "default": true,
          "description": "启用跳转到定义。开启时 Ctrl+左键直接跳转到目标位置；关闭时在当前位置下方显示预览窗口，可滚动查看目标内容（默认开启）"
        },
        "ini-ra2.showEmptyReferenceHint": {
          "type": "boolean",
          "default": true,
          "description": "在悬浮窗口中显示未找到引用的提示文案。关闭此选项可使悬浮窗口更加简洁（默认开启）"
        },
        "ini-ra2.minimapRegionSectionHeaders": {
          "type": "boolean",
          "default": false,
          "description": "右侧预览窗口是否显示区域头（会包含节头行原文，可能带注释）"
        },
        "ini-ra2.minimapMarkSectionHeaders": {
          "type": "boolean",
          "default": true,
          "description": "右侧预览窗口是否显示标记头（基于符号，通常只显示节名）"
        }
      }
    },
    "configurationDefaults": {
      "[ini]": {
        "editor.inlayHints.enabled": "off",
        "editor.codeLens": true
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "build-vsix": "npm run package && vsce package -o releases/",
    "release:prod": "npm run build-vsix",
    "release:publish": "vsce publish",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "prepare": "husky install",
    "lint:staged": "lint-staged"
  },
  "lint-staged": {
    "**/*.ts": [
      "eslint --fix --cache"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.3",
    "@types/vscode": "^1.107.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^2.32.0",
    "copy-webpack-plugin": "^12.0.0",
    "eslint": "^9.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "pinyin": "^4.0.0",
    "sharp": "^0.34.5",
    "ts-loader": "^9.5.2",
    "typescript": "^5.9.2",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1"
  }
}
